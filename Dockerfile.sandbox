# 沙箱执行镜像（Spec 14.3）：仅预装白名单数值计算包，不装数据库客户端，
# 代码经 stdin 传入、结果走 stdout；容器侧的网络/文件/进程隔离由运行时参数强制。
FROM python:3.12-slim

RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    numpy==2.1.3 \
    pandas==2.2.3 \
    scipy==1.14.1 \
    statsmodels==0.14.4 \
    scikit-learn==1.5.2

WORKDIR /work
USER 1000:1000
